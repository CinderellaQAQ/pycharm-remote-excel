<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="remote.excel.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Remote Excel Bridge" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="RemoteExcel.OpenInOffice"
                class="io.github.remoteexcel.frontend.OpenInOfficeAction"
                text="在本地 Office 中打开（不回传）"
                description="Download this remote workbook and open an independent local copy">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
